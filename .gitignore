node_modules
dist
.DS_Store

# Never commit real credentials. .env.example is the template and is safe to
# commit; .env holds the actual keys, including the Supabase service role key,
# which grants full access to the database.
.env
.env.*
!.env.example
.vercel

# Verification bundles and the temporary copies of the source they are built
# from. Every scripts/verify-*.sh traps its own cleanup, but a hard kill can
# still leave one of these behind, and none of them belong in a commit.
.rg.cjs
.eng.cjs
.journey.cjs
.pay.cjs
.balance.cjs
.a11y.cjs
src/_*.jsx
