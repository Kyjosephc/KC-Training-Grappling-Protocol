# Copy this file to .env for local testing (npm run dev), and set the same
# values as Environment Variables in your Vercel project for the live site.
#
# IMPORTANT: if any of the three REQUIRED values below is missing at build
# time, Vite replaces it with `undefined`, `supabase` becomes a compile-time
# null, and the entire signed-in app is dead-code-eliminated out of the
# bundle. The build still reports success — it just ships a shell. If a
# deployed build suddenly looks empty or tiny, check these first.

# ---- REQUIRED ----

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The Supabase user id (a UUID) of YOUR OWN coach account.
# Supabase -> Authentication -> Users -> click your account -> User UID.
# Without this: you never see the coach dashboard, and no athlete who signs
# up is ever linked to you — so sign-ups land nowhere and you never see them.
VITE_COACH_USER_ID=your-coach-account-uuid

# ---- OPTIONAL: payment details shown to athletes ----
# Leave blank and the matching option is simply not offered.

VITE_COACH_VENMO=
VITE_COACH_CASHAPP=
VITE_SUPPORT_EMAIL=

# Your Stripe Payment Link. Setting this turns the paywall into a real Pay
# button: the app appends the athlete's user id so the webhook knows who paid,
# and unlocks them on its own. Full setup in README-STRIPE.md.
VITE_COACH_PAYMENT_LINK=

# ---- SERVER ONLY: the Stripe webhook (api/stripe-webhook.js) ----
# These are set in Vercel as SECRET environment variables and are never
# compiled into the browser bundle. Do NOT prefix any of them with VITE_ —
# that would publish them. SUPABASE_SERVICE_ROLE_KEY in particular bypasses
# every row-level security rule in the database.
#
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The legal name behind the app. Set this to your LLC the day it exists and
# every agreement in the app names the company instead of a person. Bump
# WAIVER_VERSION in src/App.jsx at the same time so athletes re-sign.
VITE_PROVIDER_NAME=Strength Matrix
