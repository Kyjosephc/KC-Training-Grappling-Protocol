# Copy this file to .env for local testing (npm run dev), and add the same
# values as Environment Variables in your Vercel project settings for the
# live site.

# --- Required. Supabase: Project Settings -> API ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# --- Optional: connecting an Oura ring ---------------------------------------
# Leave every line below unset and the app simply never offers the Oura option.
# Nothing else changes. To turn it on:
#
#   1. Register a free application at https://cloud.ouraring.com/oauth/applications
#   2. Set its redirect URI to exactly the OURA_REDIRECT_URI value below
#   3. Copy the client id and client secret it gives you into the two lines below
#   4. Add all five values to Vercel (Settings -> Environment Variables) and redeploy
#
# Oura caps a new application at ten connected users until you submit it for
# review from its page in their portal.

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Must match the redirect URI on the Oura application EXACTLY, including https
# and the trailing path. Use your real production domain, not a preview URL.
OURA_REDIRECT_URI=https://your-app.vercel.app/api/oura/callback

# The serverless functions store Oura tokens under row-level security that the
# browser's anon key cannot reach, so they need the service role key to write.
# This is a secret. It belongs in Vercel's environment variables and nowhere
# else — never in VITE_ variables, which are compiled into the public bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
