# Copy this file to .env for local testing (npm run dev), and add the same
# two values as Environment Variables in your Vercel project settings for
# the live site. Find both values in Supabase: Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Oura Ring integration (optional) ---
# Register an application at https://cloud.ouraring.com (My Applications) and
# paste its two values here and in your Vercel Environment Variables. The
# redirect address to register with Oura is:
#     https://YOUR-DOMAIN/api/oura/callback
# The app shows the exact address under Settings -> Oura Ring once deployed.
# Until both values are set, the app simply shows Oura as not switched on.

OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
